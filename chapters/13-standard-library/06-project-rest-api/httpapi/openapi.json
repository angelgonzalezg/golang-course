  "info": {
    "title": "Learning Go Contacts REST API",
    "version": "1.0.0",
    "description": "Local in-memory teaching API. No authentication or persistence. Limits count UTF-8 runes after Unicode whitespace trimming; duplicate JSON keys and invalid UTF-8 are rejected. Request schemas describe syntax; resulting-contact rules and name uniqueness require runtime validation. Errors use RFC 9457 Problem Details. Reads use private, no-cache; errors and mutations use no-store. Date-based validators and ranges are not implemented."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin. Default local interactive server: http://127.0.0.1:8080"
    }
  ],
